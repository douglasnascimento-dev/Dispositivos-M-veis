<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.DespensaAlerta" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_primario</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/verde_claro</item>
        <item name="colorOnPrimaryContainer">@color/verde_escuro</item>
        <item name="colorSecondary">@color/laranja_secundario</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/verde_escuro</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.DespensaAlerta" parent="Base.Theme.DespensaAlerta" />

    <style name="Widget.DespensaAlerta.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="TextAppearance.DespensaAlerta.Selo" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/branco</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DespensaAlerta.Rotulo" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
</resources>
