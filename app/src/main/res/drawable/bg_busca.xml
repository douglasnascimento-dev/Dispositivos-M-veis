<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de busca em pílula; a borda fica verde quando o campo recebe foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/linen_claro" />
            <stroke android:width="2dp" android:color="@color/deep_juniper" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/linen_claro" />
            <stroke android:width="1dp" android:color="@color/linen_borda" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
